{
  "name": "cc-hackathon",
  "version": "0.1.0",
  "private": true,
  "description": "Claude Code Hackathon - Scenario 5: Agentic Intake Triage",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "smoke": "tsx src/smoke.ts",
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval": "tsx evals/run.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.1.0",
    "@aws-sdk/credential-providers": "^3.700.0",
    "dotenv": "^16.4.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
